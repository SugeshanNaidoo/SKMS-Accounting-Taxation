{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog/posts/tax-planning-2025", "destination": "/blog/posts/tax-planning-2026-27", "permanent": true },
    { "source": "/blog/posts/tax-planning-2025.html", "destination": "/blog/posts/tax-planning-2026-27", "permanent": true },
    { "source": "/blog/posts/sars-deadlines-2025", "destination": "/blog/posts/sars-deadlines-2026-27", "permanent": true },
    { "source": "/blog/posts/sars-deadlines-2025.html", "destination": "/blog/posts/sars-deadlines-2026-27", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/imgs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
